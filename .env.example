# EliCloud MC 白名单服务 —— 环境变量示例
#
# 本地开发：复制成 .env（不要提交）
# 生产部署：这些值放服务器 /srv/mc-whitelist/app.env（600，deploy:deploy），
#          由 deploy/deploy.sh 读出后写进 docker 可见项目目录的 .env。
#          ⚠️ 绝不要提交到 Git、不要写进镜像层、不要打印到日志。

# ---- SSO 接入（必须与 SSO 的 PUBLIC_BASE_URL 逐字一致）----
SSO_ISSUER=https://146.56.237.33/auth
SSO_JWKS_URL=https://146.56.237.33/auth/.well-known/jwks.json
JWT_AUDIENCE=elicloud-services
# 令牌必须含该 scope；配成空串 = 关闭校验（只允许本地调试）
REQUIRED_SCOPE=mc:whitelist

# ---- 存储 ----
DATABASE_URL=sqlite:////data/mc-whitelist.db

# ---- RCON ----
RCON_HOST=urania-mc
RCON_PORT=25575
# 从 MC 容器的 RCON_PASSWORD 环境变量取（见 README-deploy.md「取 RCON 密码」）
RCON_PASSWORD=
RCON_TIMEOUT=5

# ---- 业务 ----
MAX_NAMES_PER_USER=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 管理接口令牌；留空 = /v1/admin/* 整组 403（fail closed）
ADMIN_TOKEN=
SUBMIT_ATTEMPTS_PER_WINDOW=10
SUBMIT_WINDOW_SECONDS=600
LOG_LEVEL=info
